# Public browser configuration. The committed defaults point to the dedicated
# Palmer House Studio project, but production hosts may override them.
VITE_SUPABASE_URL=https://cksfnlgqgnsduqvkoqpa.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only campaign intelligence. Never prefix this key with VITE_.
OPENAI_API_KEY=your_openai_api_key
OPENAI_STUDIO_MODEL=gpt-5-mini

# Server-only subscriptions, deposits, billing portal, and signed webhook.
STRIPE_SECRET_KEY=sk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Server-only Supabase secret key for verified billing and metered AI operations.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Optional production URLs and handoffs.
PUBLIC_SITE_URL=https://www.palmerhouseproductions.com
VITE_HONEYBOOK_LEAD_FORM_URL=
VITE_STRATEGY_BOOKING_URL=
VITE_PUBLIC_REVIEW_URL=
VITE_CLICKUP_INTAKE_URL=
VITE_CONTACT_FORM_ENDPOINT=

# Optional server-only voice transcription (off until migration and live checks).
# See docs/studio-rebuild/voice-transcription.md. OPENAI_API_KEY is the fallback.
STUDIO_TRANSCRIPTION_ENABLED=false
STUDIO_TRANSCRIPTION_API_KEY=
STUDIO_TRANSCRIPTION_MODEL=gpt-transcribe

# Shared provider-cost safety cap across all Studio workspaces, in USD/month.
# See docs/studio-rebuild/billing-activation.md before enabling paid generation.
STUDIO_AI_MONTHLY_BUDGET_USD=100
